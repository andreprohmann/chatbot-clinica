# --- Meta / WhatsApp -------------------------------------------------------
# Preenchidos pelo checklist (etapa 4). O app secret também valida os webhooks.
META_APP_ID=
META_CONFIG_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=gere-um-valor-aleatorio
WHATSAPP_API_VERSION=v25.0

# Login da página https://SEU-DOMINIO/conectar-whatsapp (use uma senha forte)
ADMIN_USUARIO=admin
ADMIN_SENHA=

# Deixe vazios: a página Conectar WhatsApp guarda o número e o token no banco.
# Preencha só para usar o número de teste da Meta sem passar pela página.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- CRM -------------------------------------------------------------------
CRM_URL=http://localhost:8000/api
CRM_TOKEN=TROQUE-PELO-TOKEN-DA-API
BOT_API_TOKEN=TROQUE-PELO-TOKEN-DO-BOT

# --- Comportamento ---------------------------------------------------------
DB_PATH=bot.db
SESSAO_EXPIRA_HORAS=4
PAUSA_CELULAR_HORAS=12

# Backup diário também fora da VM (opcional). Ex.: gs://bot-clinica-backups
BACKUP_BUCKET=
